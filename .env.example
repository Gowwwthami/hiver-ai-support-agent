# Optional live LLM-as-judge. Leave empty to use the reproducible offline judge.
# Default offline judge never requires a key and never calls any API.
EVAL_JUDGE=offline

# Required only when EVAL_JUDGE=openai (never commit a real key).
OPENAI_API_KEY=

# Model used by the live judge (optional).
EVAL_JUDGE_MODEL=gpt-4o-mini